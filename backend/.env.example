# LLM Provider: dashscope | openai | deepseek
LLM_PROVIDER=dashscope

# API Key (required)
LLM_API_KEY=

# Model name (optional, defaults based on provider)
# DashScope: qwen-plus
# OpenAI: gpt-4o-mini
# DeepSeek: deepseek-chat
LLM_MODEL=
LLM_BASE_URL=

# ── Feishu Open Platform (2026 AI先锋未来人才大赛 · 专属租户自建应用) ──
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_IDS={"courses":"","topics":"","students":"","responses":""}
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_TEACHER_OPEN_ID=


# ── Audio transcription (ASR) ──
# mock（默认，演示保底，无需任何API） | qwen_asr（推荐，百炼 qwen3-asr-flash）
# | openai（whisper兼容） | dashscope（百炼 paraformer SDK，需 pip install dashscope）
# qwen_asr 复用 LLM_API_KEY 的前提是 LLM 也走百炼（LLM_BASE_URL 指向百炼 compatible-mode）；
# LLM 走其他厂商时，请单独设置 ASR_API_KEY 为百炼 API Key（ASR_API_KEY 优先于 LLM_API_KEY）。
ASR_PROVIDER=mock
# qwen_asr 留空时默认 qwen3-asr-flash；openai 默认 whisper-1；dashscope 默认 paraformer-realtime-v2
ASR_MODEL=
# 可选；留空时默认复用 LLM_API_KEY（qwen_asr/openai/dashscope 需要对应厂商的 key）
ASR_API_KEY=

# ── Dev/Test ──
# 覆盖 SQLite 库路径（默认 backend/data/grading.db）；测试用临时库，勿在生产设置
WEIXUE_DB_PATH=
